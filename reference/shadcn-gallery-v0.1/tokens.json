      "formula": "aria-invalid ring-destructive/20 (dark /40)",
      "light": {
        "oklch": "oklch(0.577 0.245 27.325)",
        "srgb": "#e7000b",
        "alpha": 0.2
      },
      "dark": {
        "oklch": "oklch(0.704 0.191 22.216)",
        "srgb": "#ff6467",
        "alpha": 0.4
      }
    },
    {
      "name": "primary-80",
      "formula": "button/badge hover bg-primary/80 - secondary hover secondary/80",
      "light": {
        "oklch": "oklch(0.205 0 0)",
        "srgb": "#171717",
        "alpha": 0.8
      },
      "dark": {
        "oklch": "oklch(0.922 0 0)",
        "srgb": "#e5e5e5",
        "alpha": 0.8
